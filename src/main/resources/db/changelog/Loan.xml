<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="create-loan-sequence" author="wassim">
        <createSequence
                sequenceName="loan_id_seq"
                startValue="1"
                incrementBy="1"
                minValue="1"/>
    </changeSet>

    <changeSet id="create-loans-table" author="wassim">
        <createTable tableName="loans">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(15,2)">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="interest_rate" type="DECIMAL(5,2)">
                <constraints nullable="false"/>
            </column>
            <column name="term_in_months" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="purpose" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="application_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="approval_date" type="TIMESTAMP"/>
            <column name="disbursement_date" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="notes" type="TEXT"/>
        </createTable>
        
        <addForeignKeyConstraint 
                baseTableName="loans" 
                baseColumnNames="user_id" 
                constraintName="fk_loan_user"
                referencedTableName="users"
                referencedColumnNames="id" />
    </changeSet>

</databaseChangeLog>
