<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="1" author="wassim">
        <createTable tableName="user_role">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column type="java.lang.Long"  name="user_id" >
                <constraints nullable="false"/>
            </column>
            <column type="java.lang.Long" name="role_id">
                <constraints nullable="false" />
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="user_role" baseColumnNames="user_id" constraintName="pk_user_roles"
                                 referencedTableName="users"
                                 referencedColumnNames="id" />
        <addForeignKeyConstraint baseTableName="user_role" baseColumnNames="role_id" constraintName="pk_user_roles2"
                                 referencedTableName="roles"
                                 referencedColumnNames="id" />
    </changeSet>



</databaseChangeLog>